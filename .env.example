# Optional: Formspree endpoint for emailing quote/order requests to the business.
# Sign up free at https://formspree.io, create a form, and paste its endpoint below.
# Copy this file to .env and fill in the value — without it, requests still reach
# the business via WhatsApp, they just won't also arrive by email.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Supabase project (Settings > API in the Supabase dashboard).
# Without these, the site falls back to its built-in placeholder content and
# the admin dashboard, enquiry persistence, and content editing are disabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Seed-script only (scripts/seed-supabase.mjs) — NEVER prefix this with VITE_,
# never set it on your hosting platform, and never commit it. It bypasses Row
# Level Security, so it must stay local. Find it in Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
